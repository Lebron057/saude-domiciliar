# ── Porta do container público (Portainer) ────
APP_PORT=8210

# ── Garage / S3 Object Storage ────────────────
# rpc_secret deve ser um hex válido de 64 caracteres
GARAGE_RPC_SECRET=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
# Access Key ID no formato Garage: GK + 24 caracteres hex
MINIO_ROOT_USER=GK000000000000000000000001
MINIO_ROOT_PASSWORD=sua-secret-key-minio-garage-123456
MINIO_ENDPOINT=garage:9000
MINIO_BUCKET=avatars
S3_BUCKET_AVATARS=avatars
S3_BUCKET_EQUIPAMENTOS=equipamentos
S3_BUCKET_CREDENCIAIS=credenciais
S3_BUCKET_DOCUMENTOS=documentos

# ── Stripe (Modo de Teste) ────────────────────
STRIPE_API_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
